# Verbindung zur bestehenden Neon-Datenbank (Benutzer braucht Schreibrechte,
# das Skript legt die Tabelle print_jobs selbst an)
DATABASE_URL= "postgresql://neondb_owner:npg_MAt3x2jheXSa@ep-shy-rice-al42w27v-pooler.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"


# Drucker: virtual (nur Oberfläche) | usb | network
PRINTER=virtual
# Nur bei usb (Werte aus `lsusb`, z. B. "ID 04b8:0e15")
#USB_VENDOR=04b8
#USB_PRODUCT=0e15
# Nur bei network
#PRINTER_HOST=192.168.1.50
#PRINTER_PROFILE=default

RECEIPT_WIDTH=42
BUSINESS_NAME=LIEFERDIENST

# Welche Bestellungen gedruckt werden (an deine echten Werte anpassen)
PAID_STATUSES=paid
CASH_METHODS=cash,cash_on_delivery
SKIP_STATUSES=cancelled
# Nur Bestellungen der letzten N Stunden werden beim Start berücksichtigt
MAX_AGE_HOURS=6

# Oberfläche (enthält Kundendaten: nur im lokalen Netz öffnen)
UI_HOST=127.0.0.1
UI_PORT=8765
